rules_version = '2';
// Firebase console > Firestore Database > Rules > paste > Publish.
// Anyone with the link can read all votes and write their own document.
// Nothing else in the project is reachable.
service cloud.firestore {
  match /databases/{database}/documents {
    match /voters/{voterId} {
      allow read: if true;
      allow write: if request.resource.data.keys().hasOnly(['name','votes','updated','nameKey'])
                   && request.resource.data.name is string
                   && request.resource.data.name.size() > 0
                   && request.resource.data.name.size() <= 40
                   && request.resource.data.votes.size() <= 200;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
